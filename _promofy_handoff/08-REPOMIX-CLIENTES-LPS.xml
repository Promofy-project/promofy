 48:       "Produtos e serviços para usar em casa",
 49:     ],
 50:   },
 51:   {
 52:     q: "Em quais dias da semana você mais costuma consumir ofertas?",
 53:     options: [
 54:       "Segunda a sexta (dias úteis)",
 55:       "Sábados",
 56:       "Domingos e feriados",
 57:     ],
 58:   },
 59:   {
 60:     q: "Você prefere cupons de:",
 61:     options: [
 62:       "Descontos diretos (ex: 20% off)",
 63:       "Benefícios extra (ex: 2 por 1, brinde grátis)",
 64:       "Combos promocionais (ex: refeição + sobremesa)",
 65:     ],
 66:   },
 67:   {
 68:     q: "Você gostaria de receber sugestões especiais próximas da sua localização?",
 69:     options: [
 70:       "Sim, sempre!",
