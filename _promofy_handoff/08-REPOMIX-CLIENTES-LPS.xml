 15: export default function PreferenciasPage() {
 16:   const [interesses, setInteresses] = React.useState<Set<string>>(
 17:     new Set(["alimentacao", "saude"]),
 18:   );
 19:   const [distancia, setDistancia] = React.useState("5km");
 20:   const [notifs, setNotifs] = React.useState({
 21:     proximosMim: true,
 22:     expirando: true,
 23:     novidades: false,
