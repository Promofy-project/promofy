 16: 
 17: const STEPS: Step[] = [
 18:   {
 19:     q: "Qual o seu principal objetivo usando promofy?",
 20:     options: [
 21:       "Economizar em restaurantes e cafés",
 22:       "Cuidar da saúde e bem-estar",
