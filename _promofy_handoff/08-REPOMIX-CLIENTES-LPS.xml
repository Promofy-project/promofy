46:                 <Plus className="h-5 w-5 shrink-0 text-primary" />
47:               )}
48:             </button>
49:             {open && (
50:               <p className="px-6 pb-5 text-[15px] leading-relaxed text-foreground/70">
51:                 {a}
52:               </p>
53:             )}
54:           </div>
55:         );
56:       })}
