  5:  * (finder patterns nos 3 cantos, separadores, timing e um alignment pattern) e
  6:  * um campo de dados estável derivado do `value` — fica nítido e convincente.
  7:  *
  8:  * Determinístico por construção (sem Math.random no render), então é seguro em
  9:  * SSR/hydration. Renderiza um único <path> de módulos pretos sobre fundo branco.
 10:  */
 11: const N = 25; // módulos (QR v2)
 12: 
 13: function hashSeed(str: string): number {
 14:   let h = 2166136261 >>> 0;
 15:   for (let i = 0; i < str.length; i++) {
 16:     h ^= str.charCodeAt(i);
 17:     h = Math.imul(h, 16777619);
 18:   }
 19:   return h >>> 0;
 20: }
 21: 
 22: function mulberry32(a: number) {
 23:   return function () {
 24:     a |= 0;
 25:     a = (a + 0x6d2b79f5) | 0;
 26:     let t = Math.imul(a ^ (a >>> 15), 1 | a);
 27:     t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
 28:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
 29:   };
 30: }
 31: 
 32: function buildGrid(value: string): boolean[][] {
 33:   const grid: boolean[][] = Array.from({ length: N }, () =>
 34:     Array.from({ length: N }, () => false),
 35:   );
 36:   const reserved: boolean[][] = Array.from({ length: N }, () =>
 37:     Array.from({ length: N }, () => false),
 38:   );
 39: 
 40:   const setBlock = (r0: number, c0: number, h: number, w: number, on: boolean) => {
 41:     for (let r = r0; r < r0 + h; r++)
 42:       for (let c = c0; c < c0 + w; c++) {
 43:         if (r < 0 || c < 0 || r >= N || c >= N) continue;
 44:         grid[r][c] = on;
 45:         reserved[r][c] = true;
 46:       }
 47:   };
 48: 
 49:   // Finder pattern 7x7 + separador (a borda reservada de 1 módulo fica branca)
 50:   const finder = (r0: number, c0: number) => {
 51:     // separador (8x8) reservado/branco
 52:     setBlock(r0 - 1, c0 - 1, 9, 9, false);
 53:     setBlock(r0, c0, 7, 7, true); // anel externo preto
 54:     setBlock(r0 + 1, c0 + 1, 5, 5, false); // anel branco
 55:     setBlock(r0 + 2, c0 + 2, 3, 3, true); // miolo preto
 56:   };
 57:   finder(0, 0); // topo-esquerda
 58:   finder(0, N - 7); // topo-direita
 59:   finder(N - 7, 0); // base-esquerda
 60: 
 61:   // Timing patterns (linha/coluna 6) — alternados
 62:   for (let i = 8; i < N - 8; i++) {
 63:     grid[6][i] = i % 2 === 0;
 64:     reserved[6][i] = true;
 65:     grid[i][6] = i % 2 === 0;
 66:     reserved[i][6] = true;
 67:   }
 68: 
 69:   // Alignment pattern 5x5 (centro ~ 18,18 no v2)
 70:   const a0 = N - 9;
 71:   setBlock(a0, a0, 5, 5, true);
 72:   setBlock(a0 + 1, a0 + 1, 3, 3, false);
 73:   setBlock(a0 + 2, a0 + 2, 1, 1, true);
 74: 
 75:   // Campo de dados: preenche o restante de forma determinística (~48%)
 76:   const rnd = mulberry32(hashSeed(value || "PROMOFY"));
 77:   for (let r = 0; r < N; r++)
 78:     for (let c = 0; c < N; c++)
 79:       if (!reserved[r][c]) grid[r][c] = rnd() > 0.52;
 80: 
 81:   return grid;
 82: }
 83: 
 84: export function QrFake({
 85:   value,
 86:   className,
 87: }: {
 88:   value: string;
 89:   className?: string;
 90: }) {
 91:   const grid = buildGrid(value);
 92:   let d = "";
 93:   for (let r = 0; r < N; r++)
 94:     for (let c = 0; c < N; c++)
 95:       if (grid[r][c]) d += `M${c} ${r}h1v1h-1z`;
 96: 
 97:   return (
 98:     <svg
 99:       viewBox={`0 0 ${N} ${N}`}
100:       role="img"
101:       aria-label="QR Code do cupom"
102:       shapeRendering="crispEdges"
103:       className={cn("h-full w-full", className)}
104:     >
105:       <rect width={N} height={N} fill="#ffffff" />
106:       <path d={d} fill="#0b0b14" />
107:     </svg>
108:   );
109: }
</file>

