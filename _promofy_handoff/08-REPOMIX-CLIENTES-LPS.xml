 85: export default function OnboardingPage() {
 86:   const router = useRouter();
 87:   const { triggerTutorial } = useMobileFlow();
 88: 
 89:   const [step, setStep] = React.useState(0);
 90:   const [done, setDone] = React.useState(false);
 91:   const [answers, setAnswers] = React.useState<string[][]>(() =>
 92:     STEPS.map(() => []),
 93:   );
 94: 
 95:   function toggle(option: string) {
 96:     setAnswers((prev) => {
 97:       const next = prev.map((a) => [...a]);
 98:       const list = next[step];
 99:       const idx = list.indexOf(option);
100:       if (idx >= 0) list.splice(idx, 1);
101:       else list.push(option);
102:       return next;
103:     });
104:   }
105: 
106:   function prosseguir() {
107:     if (step < STEPS.length - 1) setStep((s) => s + 1);
108:     else setDone(true);
109:   }
110: 
111:   function aplicarCodigo() {
112:     triggerTutorial();
113:     router.push("/m");
114:   }
115: 
116:   // ── Tela final (card azul) ─────────────────────────────
117:   if (done) {
118:     return (
119:       <div className="flex flex-1 flex-col items-center justify-center p-5">
120:         <div className="w-full max-w-[340px] rounded-[24px] bg-primary p-8 text-center text-white shadow-xl">
121:           <div className="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-full bg-white/15">
122:             <PartyPopper className="h-8 w-8 text-yellow" />
123:           </div>
124:           <h2 className="text-2xl font-extrabold leading-tight">
125:             Sua experiência será completa!
126:           </h2>
127:           <p className="mt-2 text-sm text-white/80">
128:             Tudo pronto para você economizar de verdade na sua cidade.
129:           </p>
130:           <Button
131:             onClick={aplicarCodigo}
132:             className="mt-7 w-full bg-white text-primary hover:bg-white/90"
133:           >
134:             Aplicar código
135:           </Button>
136:         </div>
137:       </div>
138:     );
139:   }
140: 
141:   // ── Passos do wizard ───────────────────────────────────
142:   const current = STEPS[step];
143: 
144:   return (
145:     <div className="flex flex-1 flex-col items-center justify-start p-5">
146:       <div className="my-2 w-full max-w-[360px] rounded-[24px] bg-surface p-6 shadow-xl">
147:         {/* header */}
148:         <div className="flex items-center gap-2">
149:           {step > 0 ? (
150:             <button
151:               type="button"
152:               aria-label="Voltar"
153:               onClick={() => setStep((s) => s - 1)}
154:               className="grid h-8 w-8 place-items-center rounded-full hover:bg-muted"
155:             >
156:               <ChevronLeft className="h-5 w-5" />
157:             </button>
158:           ) : (
159:             <span className="h-8 w-8" />
160:           )}
161:           <p className="flex-1 text-center text-sm font-bold text-foreground">
162:             Personalize Sua Experiencia
163:           </p>
164:           <span className="w-8 text-right text-xs font-semibold text-muted-foreground">
165:             {step + 1}/{STEPS.length}
166:           </span>
167:         </div>
168: 
169:         <Progress
170:           value={((step + 1) / STEPS.length) * 100}
171:           className="mt-3"
172:           indicatorClassName="bg-yellow"
173:         />
174: 
175:         <h2 className="mt-5 text-lg font-extrabold leading-snug">
176:           {current.q}
177:         </h2>
178: 
179:         <div className="mt-4 flex flex-col gap-2.5">
180:           {current.options.map((opt) => {
181:             const selected = answers[step].includes(opt);
182:             return (
183:               <button
184:                 key={opt}
185:                 type="button"
186:                 onClick={() => toggle(opt)}
187:                 aria-pressed={selected}
188:                 className={cn(
189:                   "flex items-center gap-3 rounded-xl border p-3.5 text-left text-sm transition-colors",
190:                   selected
191:                     ? "border-primary bg-primary/5 font-semibold"
192:                     : "border-border bg-surface hover:border-primary/40",
193:                 )}
194:               >
195:                 <span
196:                   className={cn(
197:                     "grid h-5 w-5 shrink-0 place-items-center rounded-md border",
198:                     selected
199:                       ? "border-primary bg-primary text-white"
200:                       : "border-border",
201:                   )}
202:                 >
203:                   {selected && <Check className="h-3.5 w-3.5" strokeWidth={3} />}
204:                 </span>
205:                 <span>{opt}</span>
206:               </button>
207:             );
208:           })}
209:         </div>
210: 
211:         <Button onClick={prosseguir} variant="onYellow" className="mt-6 w-full">
212:           Prosseguir
213:         </Button>
214: 
215:         <button
216:           type="button"
217:           onClick={() => router.push("/m")}
218:           className="mt-3 w-full text-center text-sm font-medium text-muted-foreground hover:text-foreground"
