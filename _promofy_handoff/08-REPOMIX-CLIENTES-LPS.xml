 96:                     sel
 97:                       ? "border-primary bg-primary text-primary-foreground"
 98:                       : "border-border bg-surface text-muted-foreground hover:text-foreground",
 99:                   )}
100:                 >
101:                   {d}
102:                 </button>
103:               );
104:             })}
105:           </div>
106:         </Card>
107: 
108:         {/* Section 3 — Notificações */}
109:         <Card className="p-4">
110:           <p className="mb-3 text-sm font-bold text-foreground">Notificações</p>
111:           <div className="flex flex-col divide-y divide-border">
112:             <div className="flex items-center justify-between gap-4 py-3">
