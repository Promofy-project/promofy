18: 
19: function firstName(name: string) {
20:   return name.split(" ")[0];
21: }
22: 
23: // Configuração por posição (1º, 2º, 3º)
24: const rankStyle: Record<
25:   1 | 2 | 3,
26:   { ring: string; block: string; pedestal: string; avatar: string }
27: > = {
28:   1: {
29:     ring: "ring-[#FAC81E]",
30:     block: "from-[#FACC15] to-[#E6A700]",
31:     pedestal: "h-12",
32:     avatar: "h-11 w-11",
33:   },
34:   2: {
35:     ring: "ring-[#C7CCD6]",
36:     block: "from-[#D7DCE5] to-[#AEB4C2]",
37:     pedestal: "h-8",
38:     avatar: "h-9 w-9",
39:   },
40:   3: {
41:     ring: "ring-[#E2A06A]",
42:     block: "from-[#E8B486] to-[#CD7F44]",
43:     pedestal: "h-6",
44:     avatar: "h-9 w-9",
45:   },
46: };
47: 
48: function Column({ entry, rank }: { entry: PodiumEntry; rank: 1 | 2 | 3 }) {
49:   const s = rankStyle[rank];
50:   return (
51:     <div className="flex w-1/3 flex-col items-center justify-end">
52:       {rank === 1 && (
53:         <Crown className="mb-0.5 h-4 w-4 fill-[#FAC81E] text-[#E6A700]" />
54:       )}
55:       <Avatar className={cn(s.avatar, "ring-2", s.ring)}>
56:         <AvatarFallback className="bg-primary/10 text-[11px] font-bold text-primary">
57:           {initials(entry.nome)}
58:         </AvatarFallback>
59:       </Avatar>
60:       <span className="mt-1 max-w-full truncate text-[10px] font-medium text-foreground">
61:         {firstName(entry.nome)}
62:       </span>
63:       <div
64:         className={cn(
65:           "mt-1 flex w-full items-start justify-center rounded-t-md bg-gradient-to-b pt-1 text-sm font-extrabold text-white shadow-sm",
66:           s.block,
67:           s.pedestal,
68:         )}
69:       >
70:         {rank}
71:       </div>
72:     </div>
73:   );
74: }
75: 
76: /** Pódio com 3 posições: 2º à esquerda, 1º ao centro (mais alto), 3º à direita. */
77: export function Podium({
78:   titulo,
79:   entries,
80: }: {
81:   titulo: string;
82:   /** top 3, em ordem (entries[0] = 1º lugar) */
83:   entries: PodiumEntry[];
84: }) {
85:   const [first, second, third] = entries;
86:   return (
87:     <div className="flex flex-1 flex-col items-center">
88:       <p className="mb-2 text-center text-xs font-bold text-foreground">
89:         {titulo}
90:       </p>
91:       <div className="flex w-full items-end justify-center gap-0.5">
92:         {second && <Column entry={second} rank={2} />}
93:         {first && <Column entry={first} rank={1} />}
94:         {third && <Column entry={third} rank={3} />}
95:       </div>
96:     </div>
97:   );
98: }
