<file path="src/components/cupom-acao-usar.tsx">
 1: "use client";
 2: 
 3: import { BadgeCheck } from "lucide-react";
 4: 
 5: import type { Cupom } from "@/lib/types";
 6: import { cn } from "@/lib/utils";
 7: import { Button } from "@/components/ui/button";
 8: import { Badge } from "@/components/ui/badge";
 9: import { useCouponState } from "@/components/coupon-state-provider";
10: 
11: /**
12:  * Botão reativo de "usar cupom" no detalhe. Reflete o ciclo de vida do cupom:
13:  * disponível → ativar (abre o cupom em tela cheia) → ver ativo → utilizado.
14:  * Cupons 'indisponivel' (do mock-data) ficam desabilitados.
15:  */
16: export function CupomAcaoUsar({
17:   cupom,
18:   size = "default",
19:   full = false,
20:   className,
21: }: {
22:   cupom: Cupom;
23:   size?: "sm" | "lg" | "default";
24:   full?: boolean;
25:   className?: string;
26: }) {
27:   const { getStatus, ativarCupom, verCupomAtivo } = useCouponState();
28:   const indisponivel = cupom.status === "indisponivel";
29:   const status = getStatus(cupom.id);
30:   const width = full ? "w-full" : "";
31: 
32:   if (indisponivel) {
33:     return (
34:       <Button size={size} variant="outline" disabled className={cn(width, className)}>
35:         Indisponível
36:       </Button>
37:     );
38:   }
39: 
40:   if (status === "validado") {
41:     return full ? (
42:       <div
43:         className={cn(
44:           "flex h-12 w-full items-center justify-center gap-2 rounded-btn bg-success-soft text-base font-bold text-success",
45:           className,
46:         )}
47:       >
48:         <BadgeCheck className="h-5 w-5" />
49:         Cupom utilizado
50:       </div>
51:     ) : (
52:       <Badge variant="success" className={cn("gap-1 px-3 py-1.5", className)}>
53:         <BadgeCheck className="h-4 w-4" />
54:         Utilizado
55:       </Badge>
56:     );
57:   }
58: 
59:   if (status === "ativo") {
60:     return (
61:       <Button
62:         size={size}
63:         variant="secondary"
64:         onClick={() => verCupomAtivo(cupom.id)}
65:         className={cn(width, className)}
66:       >
67:         Ver cupom ativo
68:       </Button>
69:     );
70:   }
71: 
72:   return (
73:     <Button
74:       size={size}
75:       onClick={() => ativarCupom(cupom.id)}
76:       className={cn(width, className)}
77:     >
78:       {size === "sm" ? "Utilizar" : "Usar cupom"}
79:     </Button>
80:   );
81: }
</file>

