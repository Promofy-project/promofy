 32:     if (!salvo) return;
 33:     const t = window.setTimeout(() => setSalvo(false), 3000);
 34:     return () => window.clearTimeout(t);
 35:   }, [salvo]);
 36: 
 37:   function toggleInteresse(id: string) {
 38:     setInteresses((prev) => {
 39:       const next = new Set(prev);
 40:       if (next.has(id)) {
 41:         next.delete(id);
