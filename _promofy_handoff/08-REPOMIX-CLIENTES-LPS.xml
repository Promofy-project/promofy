26:         return (
27:           <div
28:             key={i}
29:             className={cn(
30:               "overflow-hidden rounded-2xl border bg-surface shadow-[0_1px_2px_rgba(20,20,60,0.04),0_10px_30px_-12px_rgba(20,20,60,0.15)] transition-colors",
31:               open ? "border-primary" : "border-border/60",
32:             )}
33:           >
34:             <button
35:               type="button"
36:               onClick={() => setAberta(open ? null : i)}
37:               aria-expanded={open}
38:               className="flex w-full items-center justify-between gap-4 px-6 py-5 text-left"
39:             >
40:               <span className="text-base font-semibold text-foreground">
