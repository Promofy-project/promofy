 5: 
 6: export interface Column<T> {
 7:   key: string;
 8:   header: string;
 9:   render: (row: T) => React.ReactNode;
10:   align?: "left" | "right" | "center";
11:   /** classe extra na célula (th + td) */
12:   cellClassName?: string;
13: }
14: 
15: /**
16:  * Tabela simples reutilizável do /admin. Rola horizontalmente em telas
17:  * estreitas; cabeçalho sticky-friendly e linhas com hover.
18:  */
19: export function DataTable<T>({
20:   columns,
21:   rows,
22:   getRowKey,
23:   empty = "Nenhum resultado encontrado.",
24:   className,
25: }: {
26:   columns: Column<T>[];
27:   rows: T[];
28:   getRowKey: (row: T, index: number) => string;
29:   empty?: string;
30:   className?: string;
31: }) {
32:   const alignCls = (a?: Column<T>["align"]) =>
33:     a === "right" ? "text-right" : a === "center" ? "text-center" : "text-left";
34: 
35:   return (
36:     <Card className={cn("overflow-hidden", className)}>
37:       <div className="overflow-x-auto">
38:         <table className="w-full min-w-[680px] text-sm">
39:           <thead>
40:             <tr className="border-b border-border bg-muted/40">
41:               {columns.map((c) => (
42:                 <th
43:                   key={c.key}
44:                   className={cn(
45:                     "px-4 py-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground",
46:                     alignCls(c.align),
47:                     c.cellClassName,
48:                   )}
49:                 >
50:                   {c.header}
51:                 </th>
52:               ))}
53:             </tr>
54:           </thead>
55:           <tbody>
56:             {rows.length === 0 ? (
57:               <tr>
58:                 <td
59:                   colSpan={columns.length}
60:                   className="px-4 py-12 text-center text-muted-foreground"
61:                 >
62:                   {empty}
63:                 </td>
64:               </tr>
65:             ) : (
66:               rows.map((row, i) => (
67:                 <tr
68:                   key={getRowKey(row, i)}
69:                   className="border-b border-border transition-colors last:border-0 hover:bg-muted/30"
70:                 >
71:                   {columns.map((c) => (
72:                     <td
73:                       key={c.key}
74:                       className={cn(
75:                         "px-4 py-3 align-middle",
76:                         alignCls(c.align),
77:                         c.cellClassName,
78:                       )}
79:                     >
80:                       {c.render(row)}
81:                     </td>
82:                   ))}
83:                 </tr>
84:               ))
85:             )}
86:           </tbody>
87:         </table>
88:       </div>
