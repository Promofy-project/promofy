 8: /**
 9:  * Error boundary do segmento /portal. Converte um erro de runtime em uma tela
10:  * visível e recuperável (em vez de falhar silenciosamente / em branco).
11:  * Client component, como exige o App Router.
12:  */
13: export default function PortalError({
14:   error,
15:   reset,
16: }: {
17:   error: Error & { digest?: string };
18:   reset: () => void;
19: }) {
20:   React.useEffect(() => {
21:     // visível no console do navegador e nos logs da Vercel
22:     console.error("[portal] erro de runtime:", error);
23:   }, [error]);
24: 
25:   return (
26:     <div className="grid min-h-[60vh] place-items-center px-4">
27:       <div className="max-w-md text-center">
28:         <div className="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-danger-soft text-danger">
29:           <AlertCircle className="h-7 w-7" />
30:         </div>
31:         <h2 className="mt-4 text-lg font-bold">Algo deu errado nesta tela</h2>
32:         <p className="mt-1.5 text-sm text-muted-foreground">
33:           Ocorreu um erro inesperado ao carregar esta seção do portal. Tente
34:           recarregar — seus dados de demonstração não são perdidos.
35:         </p>
36:         {error?.digest && (
37:           <p className="mt-2 font-mono text-xs text-muted-foreground">
