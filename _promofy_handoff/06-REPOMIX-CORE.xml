<file path="src/components/coupon-state-provider.tsx">
  1: "use client";
  2: 
  3: import * as React from "react";
  4: 
  5: import { SALDO_BASE, PONTOS_POR_ACAO } from "@/lib/gamification";
  6: 
  7: /** Ciclo de vida de um cupom na sessão (mockado, em memória). */
  8: export type StatusCupom = "disponivel" | "ativo" | "validado";
  9: 
 10: export interface EstadoCupom {
 11:   status: Exclude<StatusCupom, "disponivel">; // só guardamos quando ativo/validado
 12:   codigo: string;
 13:   ativadoEm: number;
 14:   nps: number | null;
 15: }
 16: 
 17: interface CouponStateValue {
 18:   getStatus: (id: string) => StatusCupom;
 19:   getEstado: (id: string) => EstadoCupom | null;
 20:   /**
 21:    * Saldo de pontos do consumidor, DERIVADO do estado dos cupons (leitura pura,
 22:    * não muta nada): saldo base + pontos por cupom validado + por NPS respondido.
 23:    * Assim validar um cupom / responder o NPS reflete nos pontos exibidos, sem
 24:    * tocar nas ações de escrita do ciclo da Onda 1.
 25:    */
 26:   getPontos: () => number;
 27:   /** ativa o cupom (gera código + carimbo) e abre o cupom ativo em tela cheia */
 28:   ativarCupom: (id: string) => void;
 29:   /** reabre o cupom ativo já existente */
 30:   verCupomAtivo: (id: string) => void;
 31:   fecharCupomAtivo: () => void;
 32:   /** simula a validação pelo estabelecimento → marca 'validado' e dispara o NPS */
 33:   simularValidacao: (id: string) => void;
 34:   /** registra a nota de NPS (0–10) */
 35:   responderNps: (id: string, nota: number) => void;
 36:   /** fecha o NPS e o cupom ativo, voltando ao detalhe */
 37:   fecharNps: () => void;
 38:   /** id do cupom cujo card full-screen está aberto */
 39:   sheetId: string | null;
 40:   /** id do cupom cujo dialog de NPS está aberto */
 41:   npsId: string | null;
 42: }
 43: 
 44: const CouponStateContext = React.createContext<CouponStateValue | null>(null);
 45: 
 46: // Sem caracteres ambíguos (0/O, 1/I) p/ leitura/conferência manual.
 47: const CODE_CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
 48: 
 49: function gerarCodigo(): string {
 50:   const grupo = () =>
 51:     Array.from(
 52:       { length: 4 },
 53:       () => CODE_CHARS[Math.floor(Math.random() * CODE_CHARS.length)],
 54:     ).join("");
 55:   return `PRMF-${grupo()}-${grupo()}`;
 56: }
 57: 
 58: /**
 59:  * Estado dos cupons do consumidor, mantido EM MEMÓRIA (sem localStorage).
 60:  * Persiste entre navegações dentro de /m (o layout não remonta) e zera num
 61:  * reload — comportamento desejado para a demo. As ações (ativar/validar/NPS)
 62:  * rodam em event handlers no cliente, então Math.random/Date.now são seguros.
 63:  */
 64: export function CouponStateProvider({
 65:   children,
 66: }: {
 67:   children: React.ReactNode;
 68: }) {
 69:   const [estados, setEstados] = React.useState<Record<string, EstadoCupom>>({});
 70:   const [sheetId, setSheetId] = React.useState<string | null>(null);
 71:   const [npsId, setNpsId] = React.useState<string | null>(null);
 72: 
 73:   const value = React.useMemo<CouponStateValue>(
 74:     () => ({
 75:       getStatus: (id) => estados[id]?.status ?? "disponivel",
 76:       getEstado: (id) => estados[id] ?? null,
 77: 
 78:       getPontos: () => {
 79:         let pontos = SALDO_BASE;
 80:         for (const e of Object.values(estados)) {
 81:           if (e.status === "validado") pontos += PONTOS_POR_ACAO.resgate;
 82:           if (e.nps !== null) pontos += PONTOS_POR_ACAO.nps;
 83:         }
 84:         return pontos;
 85:       },
 86: 
 87:       ativarCupom: (id) => {
 88:         setEstados((prev) =>
 89:           prev[id]
 90:             ? prev
 91:             : {
 92:                 ...prev,
 93:                 [id]: {
 94:                   status: "ativo",
 95:                   codigo: gerarCodigo(),
 96:                   ativadoEm: Date.now(),
 97:                   nps: null,
 98:                 },
 99:               },
100:         );
101:         setSheetId(id);
102:       },
103: 
104:       verCupomAtivo: (id) => setSheetId(id),
105:       fecharCupomAtivo: () => setSheetId(null),
106: 
107:       simularValidacao: (id) => {
108:         setEstados((prev) => {
109:           const atual =
110:             prev[id] ??
111:             {
112:               status: "ativo" as const,
113:               codigo: gerarCodigo(),
114:               ativadoEm: Date.now(),
115:               nps: null,
116:             };
117:           return { ...prev, [id]: { ...atual, status: "validado" } };
118:         });
119:         setNpsId(id);
120:       },
121: 
122:       responderNps: (id, nota) =>
123:         setEstados((prev) =>
124:           prev[id] ? { ...prev, [id]: { ...prev[id], nps: nota } } : prev,
125:         ),
126: 
127:       fecharNps: () => {
128:         setNpsId(null);
129:         setSheetId(null);
130:       },
131: 
132:       sheetId,
133:       npsId,
134:     }),
135:     [estados, sheetId, npsId],
136:   );
137: 
138:   return (
139:     <CouponStateContext.Provider value={value}>
140:       {children}
141:     </CouponStateContext.Provider>
142:   );
143: }
144: 
145: export function useCouponState(): CouponStateValue {
146:   const ctx = React.useContext(CouponStateContext);
147:   if (!ctx) {
148:     // fallback seguro fora do provider
149:     return {
150:       getStatus: () => "disponivel",
151:       getEstado: () => null,
152:       getPontos: () => SALDO_BASE,
153:       ativarCupom: () => {},
154:       verCupomAtivo: () => {},
155:       fecharCupomAtivo: () => {},
156:       simularValidacao: () => {},
157:       responderNps: () => {},
158:       fecharNps: () => {},
159:       sheetId: null,
160:       npsId: null,
161:     };
162:   }
163:   return ctx;
164: }
</file>

