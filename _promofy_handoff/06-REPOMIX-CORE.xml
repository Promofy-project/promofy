 2: import { BadgeCheck, Star, UserPlus, CalendarCheck } from "lucide-react";
 3: 
 4: /**
 5:  * Regras de gamificação do consumidor (mockadas, em memória).
 6:  *
 7:  * Os valores de pontos por ação espelham a "Tabela de pontos" do admin
 8:  * (src/app/admin/configuracoes/page.tsx) para manter coerência entre as áreas.
 9:  * Mudou lá → mudar aqui.
10:  */
11: export const PONTOS_POR_ACAO = {
12:   resgate: 50,
13:   nps: 30,
14:   indicacao: 100,
15:   visita: 10,
16: } as const;
17: 
18: /** Saldo base mockado — comunica a ideia mesmo sem ações na sessão. */
19: export const SALDO_BASE = 1250;
20: 
21: export type Nivel = "Bronze" | "Prata" | "Ouro" | "Diamante";
22: 
23: interface NivelInfo {
24:   nivel: Nivel;
25:   /** ponto de entrada (pontos acumulados) */
26:   min: number;
27: }
28: 
29: /**
30:  * Faixas de nível. Os limites foram calibrados pelo mock de usuários
31:  * (src/lib/mock-data.ts): Diamante começa ~8k, Ouro ~5k, Prata ~3k.
32:  */
33: export const NIVEIS: NivelInfo[] = [
34:   { nivel: "Bronze", min: 0 },
35:   { nivel: "Prata", min: 3000 },
36:   { nivel: "Ouro", min: 5000 },
37:   { nivel: "Diamante", min: 8000 },
38: ];
39: 
40: export interface NivelCalculo {
41:   nivel: Nivel;
42:   /** próximo nível, ou null se já está no topo */
43:   proximo: Nivel | null;
44:   /** pontos que faltam para o próximo nível (0 se topo) */
45:   faltam: number;
46:   /** progresso 0–100 dentro da faixa atual (100 se topo) */
47:   progresso: number;
48: }
49: 
50: /** Deriva nível, próximo nível e progresso a partir do saldo de pontos. */
51: export function calcularNivel(pontos: number): NivelCalculo {
52:   let idx = 0;
53:   for (let i = 0; i < NIVEIS.length; i++) {
54:     if (pontos >= NIVEIS[i].min) idx = i;
55:   }
56: 
57:   const atual = NIVEIS[idx];
58:   const prox = NIVEIS[idx + 1] ?? null;
59: 
60:   if (!prox) {
61:     return { nivel: atual.nivel, proximo: null, faltam: 0, progresso: 100 };
62:   }
63: 
64:   const faixa = prox.min - atual.min;
65:   const dentro = pontos - atual.min;
66:   const progresso = faixa > 0 ? Math.round((dentro / faixa) * 100) : 0;
67: 
68:   return {
69:     nivel: atual.nivel,
70:     proximo: prox.nivel,
71:     faltam: Math.max(0, prox.min - pontos),
72:     progresso: Math.min(100, Math.max(0, progresso)),
73:   };
74: }
