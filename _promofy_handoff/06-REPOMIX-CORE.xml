<file path="src/components/favorites-provider.tsx">
 1: "use client";
 2: 
 3: import * as React from "react";
 4: 
 5: interface FavoritesContextValue {
 6:   favoriteIds: Set<string>;
 7:   isFavorite: (id: string) => boolean;
 8:   toggleFavorite: (id: string) => void;
 9: }
10: 
11: const FavoritesContext = React.createContext<FavoritesContextValue | null>(null);
12: 
13: export function FavoritesProvider({ children }: { children: React.ReactNode }) {
14:   const [favoriteIds, setFavoriteIds] = React.useState<Set<string>>(new Set());
15: 
16:   const isFavorite = React.useCallback(
17:     (id: string) => favoriteIds.has(id),
18:     [favoriteIds],
19:   );
20: 
21:   const toggleFavorite = React.useCallback((id: string) => {
22:     setFavoriteIds((prev) => {
23:       const next = new Set(prev);
24:       if (next.has(id)) {
25:         next.delete(id);
26:       } else {
27:         next.add(id);
28:       }
29:       return next;
30:     });
31:   }, []);
32: 
33:   return (
34:     <FavoritesContext.Provider value={{ favoriteIds, isFavorite, toggleFavorite }}>
35:       {children}
36:     </FavoritesContext.Provider>
37:   );
38: }
39: 
40: const NOOP_CONTEXT: FavoritesContextValue = {
41:   favoriteIds: new Set(),
42:   isFavorite: () => false,
43:   toggleFavorite: () => undefined,
44: };
45: 
46: export function useFavorites(): FavoritesContextValue {
47:   return React.useContext(FavoritesContext) ?? NOOP_CONTEXT;
48: }
</file>

