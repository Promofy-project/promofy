 6:   return twMerge(clsx(inputs));
 7: }
 8: 
 9: /** R$ 9,90 — Brazilian currency. */
10: export function formatBRL(value: number): string {
11:   return new Intl.NumberFormat("pt-BR", {
12:     style: "currency",
13:     currency: "BRL",
14:   }).format(value);
15: }
16: 
17: /** 9,90 — currency value without the R$ prefix. */
18: export function formatBRLValue(value: number): string {
19:   return new Intl.NumberFormat("pt-BR", {
20:     minimumFractionDigits: 2,
21:     maximumFractionDigits: 2,
22:   }).format(value);
23: }
24: 
25: /** 1.234 — integer with pt-BR thousands separator. */
26: export function formatNumber(value: number): string {
27:   return new Intl.NumberFormat("pt-BR").format(value);
28: }
29: 
30: /** "1,2 km" or "850 m" from a distance in kilometers. */
31: export function formatDistance(km: number): string {
32:   if (km < 1) return `${Math.round(km * 1000)} m`;
33:   return `${km.toLocaleString("pt-BR", { maximumFractionDigits: 1 })} km`;
34: }
35: 
36: /**
37:  * "23/06" — short day/month from an ISO date string.
38:  *
39:  * Lê os componentes da data ISO direto (sem criar um Date), porque
40:  * `new Date("2026-06-30")` é interpretado como meia-noite UTC e, ao formatar
41:  * com o fuso local, desloca o dia em offsets negativos (ex.: UTC-3 → "29/06").
42:  * No SSR isso diverge entre servidor (UTC na Vercel) e navegador (UTC-3 do
43:  * usuário), causando erro de hidratação do React (#418/#423/#425). Formatar a
44:  * partir dos componentes torna o resultado determinístico em qualquer fuso.
45:  */
46: export function formatShortDate(iso: string): string {
47:   const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso);
48:   if (m) return `${m[3]}/${m[2]}`;
49:   // Outros formatos (com hora/offset): fixa UTC p/ servidor e cliente concordarem.
50:   const d = new Date(iso);
51:   return d.toLocaleDateString("pt-BR", {
52:     day: "2-digit",
53:     month: "2-digit",
54:     timeZone: "UTC",
55:   });
56: }
</file>

